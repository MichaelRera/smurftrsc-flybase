{
  "manifest_version": 3,
  "name": "SmurfTrsc for FlyBase",
  "version": "0.1.1",
  "description": "Smurf vs non-Smurf and age gene expression from Zane et al. 2023 (Aging Cell) on FlyBase gene, protein, transcript and allele pages.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://flybase.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "smurftrsc-flybase@michaelrera.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
